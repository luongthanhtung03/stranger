# Port the signaling server listens on
PORT=4000
# Comma-separated list of allowed web origins (CORS + socket)
CORS_ORIGINS=http://localhost:3000
# Cloudflare Realtime TURN (optional in dev; required for phones on 4G)
# https://developers.cloudflare.com/realtime/turn/
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=
# Google login, student emails (.edu.vn) only. Keep OFF for the public beta.
# Web needs NEXT_PUBLIC_AUTH_ENABLED=true + the same client id to show the button.
AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# 32+ random chars, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
SESSION_SECRET=
